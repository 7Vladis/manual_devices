# ============ Основное ============
# DEBUG=False по умолчанию. В production SECRET_KEY и ALLOWED_HOSTS обязательны:
# без них приложение не стартует (это намеренно).
DEBUG=False

# Сгенерировать ключ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Домены и адреса, по которым открывается сервис
ALLOWED_HOSTS=localhost,127.0.0.1

# Источники, которым доверяем CSRF-токен (нужно при работе за HTTPS-прокси)
# CSRF_TRUSTED_ORIGINS=https://mandev.company.ru

# ============ HTTPS и обратный прокси ============
# Включайте только когда сервис реально работает по HTTPS, иначе не зайти.
ENABLE_HTTPS=False
# SECURE_HSTS_SECONDS=2592000
# SECURE_PROXY_SSL_HEADER=True
# USE_X_FORWARDED_HOST=True

# ============ Первый администратор ============
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ============ База данных ============
DB_NAME=my_project_db
DB_USER=my_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ============ Вложения ============
# Максимальный размер загружаемого файла в байтах (по умолчанию 25 МБ)
MAX_ATTACHMENT_SIZE=26214400

# ============ LDAP ============
# При USE_LDAP=True нужен пакет django-auth-ldap (раскомментирован в requirements.txt),
# иначе приложение не стартует с явной ошибкой.
# Сертификат положите в корень проекта под именем ldap_cert.crt — каталог
# проекта смонтирован в контейнер как /app, поэтому файл окажется по пути
# из AUTH_LDAP_CA_FILE без отдельной настройки. В git он не попадает.
USE_LDAP=False
AUTH_LDAP_SERVER_URI=ldap://your.domain.ru
AUTH_LDAP_BIND_DN=uid=django_service,cn=sysaccounts,cn=etc,dc=your,dc=domain,dc=ru
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_DN=cn=users,cn=accounts,dc=your,dc=domain,dc=ru
AUTH_LDAP_GROUP_SEARCH_DN=cn=groups,cn=accounts,dc=your,dc=domain,dc=ru
AUTH_LDAP_REQUIRE_GROUP=cn=django-users,cn=groups,cn=accounts,dc=your,dc=domain,dc=ru
AUTH_LDAP_CA_FILE=/app/ldap_cert.crt

# ============ Интеграция с YouTrack ============
YOUTRACK_BASE_URL=https://youtrack.company.com
